<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- hv_vm_create() fails without this; libkrun drives Hypervisor.framework. -->
	<key>com.apple.security.hypervisor</key>
	<true/>
	<!-- libkrun and its dependencies come from Homebrew and are ad-hoc signed,
	     so library validation would refuse to load them into a signed binary. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
