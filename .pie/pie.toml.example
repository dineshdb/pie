# pie.toml.example
# Copy this to ~/.pie/pie.toml or ./.pie/pie.toml and customize

# NOTE: top-level keys must stay ABOVE the first [table] header — anything
# after one belongs to that table.

# Default provider to use when none is specified via CLI (-p)
default_provider = "local"

# Output format for single-shot queries: "default", "markdown", or "json"
output_format = "default"

# Logging level: "debug", "info", "warn", "error"
log_level = "info"

[agent]
# Maximum number of tool-call iterations per query
max_steps = 25

[provider.local]
# Local model via MLX, Ollama, or LM Studio
model = "mlx-community/gemma-4-e4b-it-4bit"
base_url = "http://localhost:1234/v1"
api_key = "not-needed-for-local"

[provider.citadel]
# A local LLM gateway (here: Citadel, a celld worker at citadel.lvh.me/v1).
# Keys live in the gateway's own config, so pie carries none — no [secrets]
# wiring, no per-provider keys. Model ids are gateway-routed.
model = "@z-ai/glm-5.3-flash"
base_url = "http://citadel.lvh.me/v1"
temperature = 0.7

[provider.openai]
model = "gpt-4o"
base_url = "https://api.openai.com/v1"
api_key = "sk-..."

[provider.anthropic]
# Note: Pie uses OpenAI-compatible headers. Some providers may need a proxy.
model = "claude-3-5-sonnet-20240620"
base_url = "https://api.anthropic.com/v1"
anthropic_url = "https://api.anthropic.com"
api_key = "sk-ant-..."

[provider.zai]
# Zhipu AI / Z.ai
model = "glm-5.1"
base_url = "https://api.z.ai/api/paas/v4/"
anthropic_url = "https://api.z.ai/api/anthropic"
api_key = "..."

[provider.openrouter]
# ":free" suffix = free tier (rate-limited); glm-5.3-flash has no free tier
model = "z-ai/glm-5.2:free"
base_url = "openrouter"
api_key = "sk-or-..."

# Model tiers — agents reference these by name in their frontmatter.
# If an agent doesn't specify a tier, or the tier isn't defined,
# it falls back to default_provider.
#
# [model.<name>]
#   provider = "<provider_name>"  # references a [provider.*] section
#   model = "<model_name>"        # overrides the provider's default model

[model.fast]
provider = "local"
model = "mlx-community/gemma-4-e4b-it-4bit"

[model.deep]
provider = "openai"
model = "gpt-4o"

[model.broad]
provider = "anthropic"
model = "claude-opus-4-7"

# MCP servers — HTTP (streamable) endpoints that expose extra tools.
# Agents opt in per-run via frontmatter: plugins: [mcp] (every server here)
# or plugins: ["mcp:deepwiki"] (specific servers). Tools appear as
# `<name>__<tool>`. Connection failures fail the run loudly.
#
# The bundled review/search agents use deepwiki and context7.

[mcp.deepwiki]
url = "https://mcp.deepwiki.com/mcp"

[mcp.context7]
url = "https://mcp.context7.com/mcp"
# Optional — raises rate limits. A value matching a [secrets] key is
# replaced by that secret at load time.
# [mcp.context7.headers]
# CONTEXT7_API_KEY = "context7_key"

# GitHub's remote MCP needs a PAT (create: https://github.com/settings/personal-access-tokens)
# [mcp.github]
# url = "https://api.githubcopilot.com/mcp/"
# [mcp.github.headers]
# Authorization = "github_pat"

# [secrets]
# context7_key = "..."
# github_pat = "github_pat_..."

[sandbox]
# Native OS-level isolation (sandbox-exec on macOS, bubblewrap on Linux)

# Paths that the agent is explicitly forbidden from reading
deny_read = [
    "~/.ssh",
    "~/.gnupg",
    "~/.aws",
    "~/.config/gcloud"
]

# Paths that the agent is explicitly allowed to read
# If empty, most paths are readable by default unless denied
allow_read = []

# Paths where the agent is allowed to write files
allow_write = [
    ".",
    "/tmp"
]

# Specific filenames or extensions to protect from writing
deny_write = [
    ".env",
    ".env.local",
    "id_rsa"
]

# Outbound network restrictions (Note: domain filtering varies by platform)
allowed_domains = [
    "github.com",
    "*.github.com",
    "npmjs.org",
    "crates.io",
    "pypi.org"
]

denied_domains = []

# Per-model token pricing in USD per million tokens, keyed by exact model id.
# Enables the cost part of per-run usage stats (see `pie --json` and the
# llm_usage table). `cached_input` defaults to `input` when omitted.
[pricing."glm-5.1"]
input = 0.6
cached_input = 0.1
output = 2.2
